rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED PRIMITIVES ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Require verified Phone Number OTP login OR verified Email login
    function isVerifiedUser() {
      return isSignedIn() && (
        (request.auth.token.phone_number is string && request.auth.token.phone_number.size() > 0) ||
        request.auth.token.email_verified == true
      );
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'p.ganeshkar8788@gmail.com')
      );
    }

    function isStoreOwner() {
      return isVerifiedUser() && (
        (request.auth.token.email_verified == true && request.auth.token.email == 'vishwajeetnanhai199@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner')
      );
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'phone', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'phoneVerified', 'role', 'savedPincode', 'addresses', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 20
        && data.role is string && data.role in ['customer', 'admin', 'owner', 'technician']
        && (!('email' in data) || (data.email is string && data.email.size() <= 100))
        && (!('phoneVerified' in data) || data.phoneVerified is bool)
        && (!('savedPincode' in data) || (data.savedPincode is string && data.savedPincode.size() <= 10))
        && (!('addresses' in data) || (data.addresses is list && data.addresses.size() <= 10 && (data.addresses.size() == 0 || data.addresses[0] is map)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'orderNumber', 'userId', 'customerName', 'customerPhone', 'totalAmount', 'paymentStatus', 'orderStatus', 'paymentMethod', 'createdAt'])
        && data.keys().hasOnly(['id', 'orderNumber', 'userId', 'customerName', 'customerPhone', 'customerEmail', 'totalAmount', 'paymentStatus', 'orderStatus', 'paymentMethod', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 50
        && isValidId(data.userId)
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100
        && data.customerPhone is string && data.customerPhone.size() >= 10 && data.customerPhone.size() <= 20
        && (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 100))
        && data.totalAmount is number && data.totalAmount >= 0
        && data.paymentStatus is string && data.paymentStatus in ['pending', 'paid', 'failed', 'refunded']
        && data.orderStatus is string && data.orderStatus in ['placed', 'confirmed', 'processing', 'packed', 'shipped', 'out_for_delivery', 'delivered', 'cancelled', 'returned']
        && data.paymentMethod is string && data.paymentMethod in ['razorpay', 'upi', 'card', 'netbanking', 'cod']
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidServiceRequest(data) {
      return data.keys().hasAll(['id', 'userId', 'ticketNumber', 'customerName', 'customerPhone', 'serviceType', 'deviceType', 'problemDescription', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'ticketNumber', 'customerName', 'customerPhone', 'serviceType', 'deviceType', 'brandModel', 'problemDescription', 'preferredDate', 'serviceMode', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.ticketNumber is string && data.ticketNumber.size() >= 1 && data.ticketNumber.size() <= 50
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100
        && data.customerPhone is string && data.customerPhone.size() >= 10 && data.customerPhone.size() <= 20
        && data.serviceType is string && data.serviceType.size() >= 1 && data.serviceType.size() <= 100
        && data.deviceType is string && data.deviceType.size() >= 1 && data.deviceType.size() <= 80
        && (!('brandModel' in data) || (data.brandModel is string && data.brandModel.size() <= 100))
        && data.problemDescription is string && data.problemDescription.size() >= 1 && data.problemDescription.size() <= 1000
        && (!('preferredDate' in data) || (data.preferredDate is string && data.preferredDate.size() <= 30))
        && (!('serviceMode' in data) || (data.serviceMode is string && data.serviceMode in ['store_dropoff', 'on_site']))
        && data.status is string && data.status in ['new', 'contacted', 'scheduled', 'in_progress', 'waiting_parts', 'completed', 'cancelled']
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'productId', 'userId', 'userName', 'rating', 'comment', 'createdAt'])
        && data.keys().hasOnly(['id', 'productId', 'userId', 'userName', 'rating', 'comment', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.productId)
        && isValidId(data.userId)
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'title', 'brand', 'category', 'price', 'mrp', 'stock'])
        && data.keys().hasOnly([
          'id', 'title', 'titleMr', 'brand', 'category', 'subCategory',
          'price', 'mrp', 'stock', 'images', 'rating', 'reviewCount',
          'description', 'descriptionMr', 'keyFeatures', 'keyFeaturesMr',
          'specifications', 'warranty', 'returnPolicy',
          'isFeatured', 'isDealOfDay', 'isBestSeller', 'isDemo',
          'compatibleWith', 'sku', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && (!('titleMr' in data) || (data.titleMr is string && data.titleMr.size() <= 250))
        && data.brand is string && data.brand.size() >= 1 && data.brand.size() <= 80
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.price is number && data.price >= 0
        && data.mrp is number && data.mrp >= 0
        && data.stock is int && data.stock >= 0
        && (!('subCategory' in data) || (data.subCategory is string && data.subCategory.size() <= 80))
        && (!('images' in data) || (
          data.images is list && data.images.size() >= 1 && data.images.size() <= 8 &&
          data.images[0] is string && data.images[0].size() <= 350000
        ))
        && (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5))
        && (!('reviewCount' in data) || (data.reviewCount is int && data.reviewCount >= 0))
        && (!('description' in data) || (data.description is string && data.description.size() <= 3000))
        && (!('descriptionMr' in data) || (data.descriptionMr is string && data.descriptionMr.size() <= 3000))
        && (!('keyFeatures' in data) || (data.keyFeatures is list && data.keyFeatures.size() <= 20 && (data.keyFeatures.size() == 0 || data.keyFeatures[0] is string)))
        && (!('keyFeaturesMr' in data) || (data.keyFeaturesMr is list && data.keyFeaturesMr.size() <= 20 && (data.keyFeaturesMr.size() == 0 || data.keyFeaturesMr[0] is string)))
        && (!('specifications' in data) || data.specifications is map)
        && (!('warranty' in data) || (data.warranty is string && data.warranty.size() <= 300))
        && (!('returnPolicy' in data) || (data.returnPolicy is string && data.returnPolicy.size() <= 300))
        && (!('isFeatured' in data) || data.isFeatured is bool)
        && (!('isDealOfDay' in data) || data.isDealOfDay is bool)
        && (!('isBestSeller' in data) || data.isBestSeller is bool)
        && (!('isDemo' in data) || data.isDemo is bool)
        && (!('compatibleWith' in data) || (data.compatibleWith is list && data.compatibleWith.size() <= 20 && (data.compatibleWith.size() == 0 || data.compatibleWith[0] is string)))
        && (!('sku' in data) || (data.sku is string && data.sku.size() <= 50))
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidStoreSetting(data) {
      return data.keys().hasAll(['storeName'])
        && data.keys().hasOnly([
          'storeName', 'tagline', 'taglineMr', 'phone', 'whatsapp', 'email',
          'address', 'addressMr', 'city', 'district', 'state', 'pincode', 'gstin',
          'openingHours', 'openingHoursMr', 'googleMapsUrl',
          'freeShippingThreshold', 'standardShippingFee',
          'razorpayKeyId', 'isRazorpayTestMode',
          'upiId', 'upiPayeeName', 'enableUpi', 'enableCards', 'enableNetBanking', 'enableCod',
          'announcementText', 'announcementTextMr', 'heroBanners',
          'qrCodeUrl', 'bankAccountName', 'bankAccountNumber', 'bankIfsc', 'bankName',
          'fast2smsApiKey', 'deletedProductIds', 'updatedAt'
        ])
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 120
        && (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 200))
        && (!('taglineMr' in data) || (data.taglineMr is string && data.taglineMr.size() <= 200))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 30))
        && (!('email' in data) || (data.email is string && data.email.size() <= 100))
        && (!('address' in data) || (data.address is string && data.address.size() <= 300))
        && (!('addressMr' in data) || (data.addressMr is string && data.addressMr.size() <= 300))
        && (!('city' in data) || (data.city is string && data.city.size() <= 60))
        && (!('district' in data) || (data.district is string && data.district.size() <= 60))
        && (!('state' in data) || (data.state is string && data.state.size() <= 60))
        && (!('pincode' in data) || (data.pincode is string && data.pincode.size() <= 12))
        && (!('gstin' in data) || (data.gstin is string && data.gstin.size() <= 30))
        && (!('openingHours' in data) || (data.openingHours is string && data.openingHours.size() <= 120))
        && (!('openingHoursMr' in data) || (data.openingHoursMr is string && data.openingHoursMr.size() <= 120))
        && (!('googleMapsUrl' in data) || (data.googleMapsUrl is string && data.googleMapsUrl.size() <= 500))
        && (!('freeShippingThreshold' in data) || (data.freeShippingThreshold is number && data.freeShippingThreshold >= 0))
        && (!('standardShippingFee' in data) || (data.standardShippingFee is number && data.standardShippingFee >= 0))
        && (!('razorpayKeyId' in data) || (data.razorpayKeyId is string && data.razorpayKeyId.size() <= 120))
        && (!('isRazorpayTestMode' in data) || data.isRazorpayTestMode is bool)
        && (!('upiId' in data) || (data.upiId is string && data.upiId.size() <= 100))
        && (!('upiPayeeName' in data) || (data.upiPayeeName is string && data.upiPayeeName.size() <= 100))
        && (!('enableUpi' in data) || data.enableUpi is bool)
        && (!('enableCards' in data) || data.enableCards is bool)
        && (!('enableNetBanking' in data) || data.enableNetBanking is bool)
        && (!('enableCod' in data) || data.enableCod is bool)
        && (!('announcementText' in data) || (data.announcementText is string && data.announcementText.size() <= 300))
        && (!('announcementTextMr' in data) || (data.announcementTextMr is string && data.announcementTextMr.size() <= 300))
        && (!('heroBanners' in data) || (data.heroBanners is list && data.heroBanners.size() <= 10 && (data.heroBanners.size() == 0 || data.heroBanners[0] is map)))
        && (!('qrCodeUrl' in data) || (data.qrCodeUrl is string && data.qrCodeUrl.size() <= 1000))
        && (!('bankAccountName' in data) || (data.bankAccountName is string && data.bankAccountName.size() <= 120))
        && (!('bankAccountNumber' in data) || (data.bankAccountNumber is string && data.bankAccountNumber.size() <= 40))
        && (!('bankIfsc' in data) || (data.bankIfsc is string && data.bankIfsc.size() <= 30))
        && (!('bankName' in data) || (data.bankName is string && data.bankName.size() <= 120))
        && (!('fast2smsApiKey' in data) || (data.fast2smsApiKey is string && data.fast2smsApiKey.size() <= 200))
        && (!('deletedProductIds' in data) || (data.deletedProductIds is list && data.deletedProductIds.size() <= 200 && (data.deletedProductIds.size() == 0 || data.deletedProductIds[0] is string)))
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // --- COLLECTIONS ---

    // Admins registry (server/console managed)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, create, update, delete: if false;
    }

    // Customer & Staff Profiles (Strictly isolated PII)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.uid == request.auth.uid);

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && (
          incoming().role == 'customer' ||
          (incoming().role == 'admin' && request.auth.token.email_verified == true && request.auth.token.email == 'p.ganeshkar8788@gmail.com') ||
          (incoming().role == 'owner' && request.auth.token.email_verified == true && request.auth.token.email == 'vishwajeetnanhai199@gmail.com')
        )
        && (!(request.auth.token.phone_number is string) || incoming().phone == request.auth.token.phone_number)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && (!(request.auth.token.phone_number is string) || incoming().phone == existing().phone)
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'phone', 'savedPincode', 'addresses', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // Public Storefront Catalog Collections (Tiered RBAC: Admin full control, Owner Images & Prices only)
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isValidId(productId)
        && (isAdmin() || isStoreOwner())
        && isValidProduct(incoming());
      allow update: if isValidId(productId)
        && isValidProduct(incoming())
        && (
          isAdmin() ||
          (isStoreOwner() && incoming().diff(existing()).affectedKeys().hasOnly(['price', 'mrp', 'images', 'updatedAt']))
        );
      allow delete: if isValidId(productId) && isAdmin();
    }

    match /categories/{catId} {
      allow get: if isValidId(catId);
      allow list: if true;
      allow create, update, delete: if isValidId(catId) && isAdmin();
    }

    match /banners/{bannerId} {
      allow get: if isValidId(bannerId);
      allow list: if true;
      allow create, update: if isValidId(bannerId) && (isAdmin() || isStoreOwner());
      allow delete: if isValidId(bannerId) && isAdmin();
    }

    match /coupons/{couponId} {
      allow get: if isValidId(couponId);
      allow list: if true;
      allow create, update, delete: if isValidId(couponId) && isAdmin();
    }

    // Storefront Settings (Admin full control, Owner Banners & Payments only)
    match /storeSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create: if isValidId(settingId)
        && (isAdmin() || isStoreOwner())
        && isValidStoreSetting(incoming());
      allow update: if isValidId(settingId)
        && isValidStoreSetting(incoming())
        && (
          isAdmin() ||
          (isStoreOwner() && incoming().diff(existing()).affectedKeys().hasOnly([
            'heroBanners', 'upiId', 'upiPayeeName',
            'enableUpi', 'enableCards', 'enableNetBanking', 'enableCod',
            'razorpayKeyId', 'isRazorpayTestMode', 'qrCodeUrl',
            'bankAccountName', 'bankAccountNumber', 'bankIfsc', 'bankName',
            'fast2smsApiKey', 'updatedAt'
          ]))
        );
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // Orders (Customer owns their orders, Admin manages lifecycle)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && ((isVerifiedUser() && existing().userId == request.auth.uid) || isAdmin());
      allow list: if (isVerifiedUser() && resource.data.userId == request.auth.uid) || isAdmin();

      allow create: if isValidId(orderId)
        && isVerifiedUser()
        && isValidOrder(incoming())
        && incoming().userId == request.auth.uid
        && incoming().orderStatus == 'placed'
        && incoming().createdAt == request.time;

      allow update: if isValidId(orderId)
        && isAdmin()
        && isValidOrder(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;

      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Service Requests (Authenticated Customer owns their tickets, Admin manages)
    match /serviceRequests/{ticketId} {
      allow get: if isValidId(ticketId) && ((isVerifiedUser() && existing().userId == request.auth.uid) || isAdmin());
      allow list: if (isVerifiedUser() && resource.data.userId == request.auth.uid) || isAdmin();

      allow create: if isValidId(ticketId)
        && isVerifiedUser()
        && isValidServiceRequest(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'new'
        && incoming().createdAt == request.time;

      allow update: if isValidId(ticketId)
        && isAdmin()
        && isValidServiceRequest(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;

      allow delete: if isValidId(ticketId) && isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isValidId(reviewId)
        && isVerifiedUser()
        && isValidReview(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if isValidId(reviewId) && isAdmin();
    }
  }
}
